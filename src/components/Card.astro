---
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";

export interface CardData {
  title: string;
  ingress?: string;
  description?: string;
  pubDatetime?: Date;
  ogImage?: unknown;
  kategori?: string;
  tags?: string[];
  nivå?: string;
  tid?: string;

  kostnad?: string; // NYTT
}

export interface Props {
  variant?: "h2" | "h3";
  data: CardData;
  id: string;
  filePath?: string;
  eyebrow?: string;

  // override länk (behåller getPath som default)
  href?: string;

  // tvinga bild + fallback om ogImage saknas
  forceImage?: boolean;
  fallbackImage?: string;
}

const {
  variant = "h3",
  data,
  id,
  filePath,
  eyebrow,
  href: hrefOverride,
  forceImage = false,
  fallbackImage,
} = Astro.props as Props;

const href = hrefOverride ?? getPath(id, filePath);

const title = data.title;
const ingress = data.ingress ?? data.description;

const dateStr = data.pubDatetime
  ? data.pubDatetime.toLocaleDateString("sv-SE", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
  : "";

const ogImageRaw = data.ogImage as unknown;
const ogImage =
  typeof ogImageRaw === "string"
    ? ogImageRaw
    : (ogImageRaw && typeof ogImageRaw === "object" && "src" in (ogImageRaw as any)
        ? (ogImageRaw as any).src
        : null);

// Bild: använd ogImage om den finns, annars fallback om forceImage=true
const imageSrc = ogImage ?? (forceImage ? (fallbackImage ?? null) : null);

const primaryPill = data.kategori ?? data.tags?.[0];

// NYTT: lägg till kostnad i pill-raden
const pills = [primaryPill, data.nivå, data.tid, data.kostnad].filter(Boolean) as string[];

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: "mt-2 text-xl font-semibold tracking-tight",
};
---

<li class="mt-4">
  <a href={href} class="so-card so-card-hover block overflow-hidden">
    {
      imageSrc && (
        <img
          src={imageSrc}
          alt={title}
          class="h-44 w-full object-cover sm:h-56"
          loading="lazy"
          decoding="async"
        />
      )
    }

    <div class="p-5 sm:p-6">
      <div class="text-xs font-semibold tracking-wide text-foreground/60">
        {(eyebrow ?? "BLOGG")} · {dateStr}
      </div>

      {variant === "h2" ? <h2 {...headerProps}>{title}</h2> : <h3 {...headerProps}>{title}</h3>}

      {ingress && <p class="mt-2 text-sm text-foreground/75">{ingress}</p>}

      {
        pills.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {pills.map((p) => (
              <span class="so-pill">{p}</span>
            ))}
          </div>
        )
      }
    </div>
  </a>
</li>
