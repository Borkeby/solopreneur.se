---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export async function getStaticPaths() {
  const items = await getCollection("downloads", ({ data }) => !data.draft);

  return items.map((p) => {
    const slug = String((p.data as any).slug ?? p.id).replace(/^\/+/, "");
    return {
      params: { slug },
      props: { slug },
    };
  });
}

const { slug } = Astro.props as { slug: string };

const items = await getCollection("downloads", ({ data }) => !data.draft);
const entry = items.find((p) => String((p.data as any).slug ?? p.id).replace(/^\/+/, "") === slug);

if (!entry) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(entry);

// SEO title/description (prioriterar din content, men säkrar att "gratis" + "ladda ner" finns)
const baseTitle = entry.data.title ?? "Nedladdning";
const seoTitle = baseTitle.includes("ladda ner") || baseTitle.includes("Ladda ner")
  ? `${baseTitle} | Solopreneur`
  : `${baseTitle} | Solopreneur`;

const seoDescription =
  (entry.data.description ?? "").trim().length
    ? entry.data.description!
    : "Ladda ner gratis mallar och checklistor för soloprenörer.";

const canonical = `/nedladdningar/${slug}/`;

const file = (entry.data as any).file as
  | { href?: string; label?: string; type?: string }
  | undefined;

const fileHref = file?.href ?? "";
const fileLabel = file?.label ?? "Ladda ner";
const fileType = (file?.type ?? "").toUpperCase();

// Enkel FAQ schema (matchar körjournal-sidan bra; fungerar även generellt)
const faq = [
  {
    q: "Är nedladdningen gratis?",
    a: "Ja, du kan ladda ner mallen utan kostnad.",
  },
  {
    q: "Vilket format är filen i?",
    a: fileType ? `Filen är i ${fileType}-format.` : "Formatet framgår vid nedladdningsknappen.",
  },
  {
    q: "Kan jag skriva ut mallen?",
    a: "Ja, du kan skriva ut mallen och använda den på papper om du vill.",
  },
  {
    q: "Kan jag fylla i mallen digitalt?",
    a: "Om mallen är ifyllningsbar kan du fylla i den direkt och spara lokalt.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((x) => ({
    "@type": "Question",
    "name": x.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": x.a,
    },
  })),
};
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="pt-10 pb-12">
    <section class="mx-auto max-w-[1100px] px-4 sm:px-6">
      <div class="text-xs font-semibold tracking-wide text-foreground/60">
        NEDLADDNING{fileType ? ` · ${fileType}` : ""}
      </div>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight">
        {entry.data.title}
      </h1>

      {entry.data.description && (
        <p class="mt-3 max-w-3xl text-base text-foreground/75">
          {entry.data.description}
        </p>
      )}

      {fileHref && (
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="so-btn-primary" href={fileHref} download>
            {fileLabel}
          </a>

          <a class="so-btn-secondary" href="/nedladdningar/">
            Visa alla nedladdningar
          </a>
        </div>
      )}

      <article class="prose prose-slate dark:prose-invert mt-8 max-w-none">
        <Content />
      </article>


    </section>
  </main>

  <Footer />
</Layout>

<!-- Canonical + FAQ schema -->
<link rel="canonical" href={canonical} />

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
