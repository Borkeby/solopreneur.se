---
/**
 * Modal-vänlig färgpipett + färgväljare.
 * Viktigt: inga globala body/:root-stilar här. Inget sparas.
 */
const prefix = "colorpick";
---

<div id={`${prefix}-root`} class="space-y-4">
  <div class="space-y-2">
    <p class="text-sm text-foreground/70">
      Peka på en färg på skärmen (pipett) eller välj manuellt. Kopiera HEX, HEX8, RGB, RGBA och HSL. Bearbetningen sker lokalt i din webbläsare.
    </p>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-black/10 bg-black/[0.02] p-4 dark:border-white/10 dark:bg-white/[0.03]">
      <div
        id={`${prefix}-swatch`}
        class="h-44 w-full rounded-xl border border-black/10 dark:border-white/10"
        aria-label="Förhandsvisning"
      ></div>

      <div class="mt-3 space-y-2">
        <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
          <span class="text-foreground/70">Bakgrund</span>
          <code id={`${prefix}-css`} class="text-xs text-foreground/70"></code>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
          <span class="text-foreground/70">Rek. textfärg</span>
          <code id={`${prefix}-text`} class="text-xs font-semibold"></code>
        </div>
      </div>
    </div>

    <div class="space-y-4 rounded-xl border border-black/10 bg-black/[0.02] p-4 dark:border-white/10 dark:bg-white/[0.03]">
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="space-y-1">
          <div class="text-sm font-semibold">Välj färg</div>
          <input
            id={`${prefix}-picker`}
            type="color"
            value="#1A73E8"
            class="h-11 w-full rounded-xl border border-black/10 bg-white px-2 dark:border-white/15 dark:bg-white/[0.06]"
          />
        </label>

        <label class="space-y-1">
          <div class="text-sm font-semibold">HEX (input)</div>
          <input
            id={`${prefix}-hex`}
            type="text"
            inputmode="text"
            autocomplete="off"
            spellcheck="false"
            value="#1A73E8"
            placeholder="#RRGGBB"
            class="h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm dark:border-white/15 dark:bg-white/[0.06]"
          />
        </label>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          id={`${prefix}-eyedropperBtn`}
          type="button"
          class="inline-flex items-center justify-center rounded-xl border border-black/10 bg-white px-4 py-2 text-sm font-semibold hover:bg-black/[0.03] disabled:cursor-not-allowed disabled:opacity-50 dark:border-white/15 dark:bg-white/[0.06] dark:hover:bg-white/[0.10]"
        >
          Pipett: peka och hämta färg
        </button>

        <span id={`${prefix}-eyedropperHint`} class="text-sm text-foreground/60"></span>
      </div>

      <p id={`${prefix}-hexError`} class="hidden text-sm text-red-600">
        Ogiltig HEX-kod. Tillåtna format: #RGB, #RGBA, #RRGGBB, #RRGGBBAA (med eller utan #).
      </p>

      <div class="space-y-3">
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <div class="text-sm font-semibold">R</div>
            <input id={`${prefix}-rNum`} type="number" min="0" max="255" value="26"
              class="h-9 w-24 rounded-xl border border-black/10 bg-white px-2 text-sm dark:border-white/15 dark:bg-white/[0.06]" />
          </div>
          <input id={`${prefix}-r`} type="range" min="0" max="255" value="26" class="w-full" />
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <div class="text-sm font-semibold">G</div>
            <input id={`${prefix}-gNum`} type="number" min="0" max="255" value="115"
              class="h-9 w-24 rounded-xl border border-black/10 bg-white px-2 text-sm dark:border-white/15 dark:bg-white/[0.06]" />
          </div>
          <input id={`${prefix}-g`} type="range" min="0" max="255" value="115" class="w-full" />
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <div class="text-sm font-semibold">B</div>
            <input id={`${prefix}-bNum`} type="number" min="0" max="255" value="232"
              class="h-9 w-24 rounded-xl border border-black/10 bg-white px-2 text-sm dark:border-white/15 dark:bg-white/[0.06]" />
          </div>
          <input id={`${prefix}-b`} type="range" min="0" max="255" value="232" class="w-full" />
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <div class="text-sm font-semibold">Alfa</div>
            <input id={`${prefix}-aNum`} type="number" min="0" max="100" value="100"
              class="h-9 w-24 rounded-xl border border-black/10 bg-white px-2 text-sm dark:border-white/15 dark:bg-white/[0.06]" />
          </div>
          <input id={`${prefix}-a`} type="range" min="0" max="100" value="100" class="w-full" />
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-3 rounded-xl border border-black/10 bg-black/[0.02] p-4 dark:border-white/10 dark:bg-white/[0.03]">
    <div class="text-sm font-semibold">Koder</div>

    <div class="grid gap-3">
      <div class="grid gap-2 sm:grid-cols-[90px_1fr_120px] sm:items-center">
        <div class="text-sm text-foreground/70">HEX</div>
        <input id={`${prefix}-outHex`} class="h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm dark:border-white/15 dark:bg-white/[0.06]" readonly />
        <button data-copy={`${prefix}-outHex`} type="button" class="h-11 rounded-xl bg-black px-4 text-sm font-semibold text-white dark:bg-white dark:text-black">Kopiera</button>
      </div>

      <div class="grid gap-2 sm:grid-cols-[90px_1fr_120px] sm:items-center">
        <div class="text-sm text-foreground/70">HEX8</div>
        <input id={`${prefix}-outHex8`} class="h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm dark:border-white/15 dark:bg-white/[0.06]" readonly />
        <button data-copy={`${prefix}-outHex8`} type="button" class="h-11 rounded-xl bg-black px-4 text-sm font-semibold text-white dark:bg-white dark:text-black">Kopiera</button>
      </div>

      <div class="grid gap-2 sm:grid-cols-[90px_1fr_120px] sm:items-center">
        <div class="text-sm text-foreground/70">RGB</div>
        <input id={`${prefix}-outRgb`} class="h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm dark:border-white/15 dark:bg-white/[0.06]" readonly />
        <button data-copy={`${prefix}-outRgb`} type="button" class="h-11 rounded-xl bg-black px-4 text-sm font-semibold text-white dark:bg-white dark:text-black">Kopiera</button>
      </div>

      <div class="grid gap-2 sm:grid-cols-[90px_1fr_120px] sm:items-center">
        <div class="text-sm text-foreground/70">RGBA</div>
        <input id={`${prefix}-outRgba`} class="h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm dark:border-white/15 dark:bg-white/[0.06]" readonly />
        <button data-copy={`${prefix}-outRgba`} type="button" class="h-11 rounded-xl bg-black px-4 text-sm font-semibold text-white dark:bg-white dark:text-black">Kopiera</button>
      </div>

      <div class="grid gap-2 sm:grid-cols-[90px_1fr_120px] sm:items-center">
        <div class="text-sm text-foreground/70">HSL</div>
        <input id={`${prefix}-outHsl`} class="h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm dark:border-white/15 dark:bg-white/[0.06]" readonly />
        <button data-copy={`${prefix}-outHsl`} type="button" class="h-11 rounded-xl bg-black px-4 text-sm font-semibold text-white dark:bg-white dark:text-black">Kopiera</button>
      </div>

      <div class="grid gap-2 sm:grid-cols-[90px_1fr_120px] sm:items-center">
        <div class="text-sm text-foreground/70">CSS</div>
        <input id={`${prefix}-outCss`} class="h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm dark:border-white/15 dark:bg-white/[0.06]" readonly />
        <button data-copy={`${prefix}-outCss`} type="button" class="h-11 rounded-xl bg-black px-4 text-sm font-semibold text-white dark:bg-white dark:text-black">Kopiera</button>
      </div>
    </div>

    <p id={`${prefix}-toast`} class="hidden text-sm text-foreground/70" aria-live="polite">Kopierat</p>
  </div>
</div>

<script>
  import initColorPicker from "@/scripts/color-picker";

  const run = () => initColorPicker({ prefix: "colorpick" });

  document.addEventListener("DOMContentLoaded", run);
  document.addEventListener("astro:page-load", run);
  document.addEventListener("astro:after-swap", run);
</script>
