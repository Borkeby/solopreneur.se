---
/**
 * Beehiiv embed (iframe) + robust script-loader som funkar med Astro transitions.
 */
interface Props {
  title?: string;
  publicUrl?: string; // fallback-länk (din publika Beehiiv-sida eller valfri sida)
  embedUrl: string;   // Beehiiv iframe src
  legalText?: string;
}

const {
  title = "Prenumerera på nyhetsbrev",
  publicUrl = "/",
  embedUrl,
  legalText = "Genom att anmäla dig godkänner du att vi lagrar din e-post för utskick. Du kan när som helst avsluta.",
} = Astro.props;
---

<section class="so-card p-5 sm:p-6">
  <div class="text-lg font-semibold tracking-tight">{title}</div>

  <div class="mt-3">
    <iframe
      src={embedUrl}
      class="beehiiv-embed so-beehiiv-iframe"
      data-test-id="beehiiv-embed"
      frameborder="0"
      scrolling="no"
      loading="lazy"
      title={title}
    />
  </div>

  <noscript>
    Aktivera JavaScript för att kunna skicka formuläret.
    <a href={publicUrl} target="_blank" rel="noopener">Öppna prenumerationssidan</a>.
  </noscript>

  <p class="mt-4 text-xs text-foreground/60">{legalText}</p>
</section>

<script is:inline>
  // Ladda Beehiiv embed.js exakt en gång (även vid interna navigeringar med ClientRouter)
  (function loadBeehiivOnce() {
    if (typeof window === "undefined") return;
    if (window.__beehiivEmbedLoaded) return;

    window.__beehiivEmbedLoaded = true;

    var s = document.createElement("script");
    s.async = true;
    s.src = "https://subscribe-forms.beehiiv.com/embed.js";
    document.head.appendChild(s);
  })();
</script>

<style>
  .so-beehiiv-iframe {
    width: 100%;
    max-width: 660px;
    height: 415px; /* startvärde; embed.js justerar normalt höjd */
    border: 0;
    background: transparent;
    display: block;
  }
</style>
