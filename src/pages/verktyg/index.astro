---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import momsToolImage from "@/assets/images/tools/moms.jpg";
import timprisToolImage from "@/assets/images/tools/timpris.jpg";
import bildToolImage from "@/assets/images/tools/bild.jpg";
import pdfToolImage from "@/assets/images/tools/adobe.jpg";

const pageTitle = "Verktyg";
const pageDescription =
  "Kalkylatorer och verktyg för företagare: moms, timpris, bildformat för sociala medier och PDF-verktyg.";

const tools = [
  {
    tag: "Skatt & prissättning",
    title: "Momskalkylator",
    description:
      "Räkna ut moms baklänges eller framlänges med 25, 12 eller 6 %. Se moms och belopp exkl. moms direkt.",
    href: "/verktyg/moms-kalkylator/",
    image: momsToolImage.src,
    imageAlt: "Momskalkylator",
    legacyHash: "moms-kalkylator",
  },
  {
    tag: "Skatt & prissättning",
    title: "Timpriskalkylator",
    description:
      "Räkna ut timpris baserat på mål, kostnader och debiterbar tid.",
    href: "/verktyg/timpriskalkylator/",
    image: timprisToolImage.src,
    imageAlt: "Timpriskalkylator",
    legacyHash: "timpriskalkylator",
  },
  {
    tag: "Marknadsföring",
    title: "Bildverktyg",
    description:
      "Beskär och exportera bilder i rätt format för Instagram, Facebook, LinkedIn, YouTube och TikTok.",
    href: "/verktyg/bildverktyg/",
    image: bildToolImage.src,
    imageAlt: "Bildverktyg",
    legacyHash: "bildverktyg",
  },
  {
    tag: "Dokument",
    title: "PDF-dela",
    description:
      "Dela upp en PDF i en fil per sida. Bearbetningen sker lokalt i din webbläsare.",
    href: "/verktyg/pdf-dela/",
    image: pdfToolImage.src,
    imageAlt: "PDF-dela",
    legacyHash: "pdf-dela",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content">
    <section class="pt-8 pb-10">
      <header>
        <h1 class="so-section-title">Verktyg</h1>
        <p class="so-section-muted">
          Välj ett verktyg. Varje verktyg har en egen sida med instruktioner och snabb åtkomst.
        </p>
      </header>

      <div class="mt-4 space-y-4">
        {tools.map((t) => (
          <a href={t.href} class="so-card so-card-hover block overflow-hidden">
            <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:gap-6 sm:p-6">
              <div class="min-w-0 flex-1">
                <div class="text-xs font-semibold tracking-wide text-foreground/60">
                  VERKTYG · {t.tag}
                </div>
                <div class="mt-2 text-lg font-semibold tracking-tight">
                  {t.title}
                </div>
                <p class="mt-2 text-sm text-foreground/75">{t.description}</p>
              </div>

              {t.image && (
                <img
                  src={t.image}
                  alt={t.imageAlt ?? t.title}
                  class="h-28 w-full rounded-xl object-cover sm:h-24 sm:w-40"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <!-- Backward compatibility: /verktyg/#pdf-dela => /verktyg/pdf-dela/ -->
  <script is:inline>
    (function () {
      const map = {
        "moms-kalkylator": "/verktyg/moms-kalkylator/",
        "timpriskalkylator": "/verktyg/timpriskalkylator/",
        "bildverktyg": "/verktyg/bildverktyg/",
        "pdf-dela": "/verktyg/pdf-dela/",
      };

      const key = (location.hash || "").replace(/^#/, "").trim();
      if (!key) return;

      const target = map[key];
      if (target) location.replace(target);
    })();
  </script>
</Layout>
