---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

import SolopreneurLogo from "@/assets/images/Solopreneur.jpg";

const { pathname } = Astro.url;

const normalize = (p: string) => {
  if (!p) return "/";
  let s = p.trim();
  if (!s.startsWith("/")) s = "/" + s;
  if (s.length > 1 && s.endsWith("/")) s = s.slice(0, -1);
  return s;
};

const currentPath = normalize(
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname
);

const isActive = (path: string) => {
  const target = normalize(path);
  if (currentPath === target) return true;

  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = target.split("/").filter(p => p.trim());

  return currentPathArray[0] && pathArray[0] && currentPathArray[0] === pathArray[0];
};

const nav = [
  { label: "Blogg", href: "/posts/", active: "/posts" },
  { label: "Playbooks", href: "/playbooks/", active: "/playbooks" },
  { label: "Taggar", href: "/tags/", active: "/tags" },
  { label: "Verktyg", href: "/verktyg/", active: "/verktyg" },
  { label: "Nyhetsbrev", href: "/nyhetsbrev/", active: "/nyhetsbrev" },
  { label: "Community", href: "/community/", active: "/community" },
  { label: "Om", href: "/om/", active: "/om" },
];
---

<header class="border-b border-border bg-surface">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-surface px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Hoppa till innehåll
  </a>

  <div class="mx-auto max-w-app px-4">
    <div class="flex items-center justify-between gap-4 py-4 sm:py-6">
      <div class="flex items-center gap-6">
        <a href="/" class="inline-flex items-center" aria-label={SITE.title}>
          <img
            src={SolopreneurLogo.src}
            alt={SITE.title}
            class="h-8 w-auto sm:h-10"
            loading="eager"
            decoding="async"
          />
        </a>

        <nav class="hidden sm:block" aria-label="Huvudnavigering">
          <ul class="flex items-center gap-5 [&>li>a]:text-sm [&>li>a]:font-semibold [&>li>a]:text-foreground/80 [&>li>a]:hover:text-accent">
            {nav.map(item => {
              const active = isActive(item.active);
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={{ "active-nav": active }}
                    aria-current={active ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>

      <div class="flex items-center gap-1">
        <a
          href="/nyhetsbrev/"
          class="hidden sm:inline-flex so-btn-primary"
          aria-label="Prenumerera på nyhetsbrevet"
        >
          Prenumerera
        </a>

        <LinkButton
          href="/search"
          class:list={[
            "focus-outline flex p-2",
            { "[&>svg]:stroke-accent": isActive("/search") },
          ]}
          ariaLabel="Sök"
          title="Sök"
        >
          <IconSearch />
          <span class="sr-only">Sök</span>
        </LinkButton>

        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline relative size-10 p-2 hover:[&>svg]:stroke-accent"
              title="Växla tema"
              aria-label="Växla tema"
              aria-live="polite"
            >
              <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }

        <button
          id="menu-btn"
          class="focus-outline p-2 sm:hidden"
          aria-label="Öppna meny"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
      </div>
    </div>

    <nav class="sm:hidden pb-4" aria-label="Mobilnavigering">
      <ul
        id="menu-items"
        class:list={[
          "hidden",
          "flex flex-col gap-1",
          "[&>li>a]:block [&>li>a]:rounded-xl [&>li>a]:px-3 [&>li>a]:py-3 [&>li>a]:font-semibold [&>li>a]:text-foreground/80 [&>li>a]:hover:text-accent",
        ]}
      >
        <li>
          <a href="/nyhetsbrev/" class="so-btn-primary mx-3 my-2 justify-center">
            Prenumerera
          </a>
        </li>

        {nav.map(item => {
          const active = isActive(item.active);
          return (
            <li>
              <a
                href={item.href}
                class:list={{ "active-nav": active }}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
function toggleNav() {
  const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
  const menuItems = document.querySelector<HTMLElement>("#menu-items");
  const menuIcon = document.querySelector<HTMLElement>("#menu-icon");
  const closeIcon = document.querySelector<HTMLElement>("#close-icon");

  if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

  if (menuBtn.dataset.bound === "1") return;
  menuBtn.dataset.bound = "1";

  menuBtn.addEventListener("click", () => {
    const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

    menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
    menuBtn.setAttribute("aria-label", openMenu ? "Öppna meny" : "Stäng meny");

    menuItems.classList.toggle("hidden");
    menuIcon.classList.toggle("hidden");
    closeIcon.classList.toggle("hidden");
  });
}


  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
