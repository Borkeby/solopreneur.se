---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const pageTitle = "Community – Solopreneur.se";
const pageDescription = "Gå med i Solopreneurs community på Discord för frågor, feedback och diskussioner.";
const discordInviteUrl = "https://discord.com/invite/xZYxNJXy4b";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content">
    <section class="pt-8 pb-10">
      <h1 class="so-section-title">Community</h1>
      <p class="so-section-muted">
        Ett forum för soloföretagare och små tjänstebolag: frågor, feedback, struktur och praktiska lösningar.
      </p>

      <div class="so-card mt-4 p-5 sm:p-6">
        <h2 class="text-lg font-semibold tracking-tight">Vad du får</h2>
        <ul class="mt-3 list-disc pl-5 text-sm text-foreground/80">
          <li>Feedback på idéer, upplägg och innehåll</li>
          <li>Diskussioner om prissättning, struktur och genomförande</li>
          <li>Uppdateringar när nya guider och verktyg släpps</li>
        </ul>

        <div class="mt-5 flex flex-wrap gap-3">
          <a class="so-btn-primary" href={discordInviteUrl} target="_blank" rel="noopener noreferrer">
            Gå med via Discord-inbjudan
          </a>

          <a class="so-btn-secondary" data-pi-event="newsletter_signup" href="/nyhetsbrev/">
            Eller prenumerera på nyhetsbrevet
          </a>
        </div>

        <p class="mt-4 text-xs text-foreground/60">
          Du lämnar Solopreneur.se och öppnar Discord i ny flik.
        </p>

        <div class="mt-4">
          <p class="text-sm text-foreground/80">
            Direktlänk (om du redan är med):
            <a
              class="ml-2 text-accent underline decoration-dashed underline-offset-4 hover:opacity-90"
              href="https://discord.com/channels/1409621217660375071/1409621218277064859"
              target="_blank"
              rel="noopener noreferrer"
            >
              Öppna communityt i Discord
            </a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
