---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

import defaultCover from "@/assets/images/blog/default-cover.jpg";

export async function getStaticPaths() {
  const entries = await getCollection("playbooks", ({ data }) => !data.draft);

  // Catch-all route: slug kan innehålla "/"
  return entries.map(p => ({
    params: { slug: p.id },
    props: { id: p.id },
  }));
}

const { id } = Astro.props as { id: string };

const entries = await getCollection("playbooks", ({ data }) => !data.draft);
const entry = entries.find(p => p.id === id);

if (!entry) {
  return new Response(null, { status: 404 });
}

const toImageSrc = (v: unknown): string | null => {
  if (!v) return null;

  if (typeof v === "string") {
    const s = v.trim();
    return s.length ? s : null;
  }

  if (typeof v === "object" && v !== null && "src" in v) {
    const src = (v as { src?: unknown }).src;
    return typeof src === "string" && src.trim().length ? src.trim() : null;
  }

  return null;
};

// Behåll OG-image för metadata, men rendera ingen bild på sidan
const cover = toImageSrc(entry.data.ogImage) ?? defaultCover.src;

const title = entry.data.title;
const description =
  entry.data.description ??
  entry.data.ingress ??
  SITE.desc;

const pubDatetime = entry.data.pubDatetime;
const modDatetime = entry.data.modDatetime ?? null;

const dateStr = pubDatetime
  ? pubDatetime.toLocaleDateString("sv-SE", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
  : "";

const nivå = (entry.data.nivå ?? "").trim();
const tid = (entry.data.tid ?? "").trim();
const metaParts = [
  "GUIDER",
  dateStr ? dateStr : null,
  nivå ? nivå : null,
  tid ? tid : null,
].filter(Boolean);

const { Content } = await render(entry);
---

<Layout
  title={`${title} – Playbook`}
  description={description}
  ogImage={cover}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <main id="main-content">
    <section class="pt-8 pb-10">
      <a
        href="/playbooks/"
        class="text-sm font-semibold text-foreground/70 hover:text-accent"
      >
        &larr; Tillbaka till Guider
      </a>

      <h1 class="mt-3 text-3xl font-semibold tracking-tight">
        {title}
      </h1>

      <div class="mt-2 text-sm text-foreground/70">
        {metaParts.join(" · ")}
      </div>

      <div class="so-card mt-6">
        <div class="p-5 sm:p-6">
          <article class="app-prose">
            <Content />
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
