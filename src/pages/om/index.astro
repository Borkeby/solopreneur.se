---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import DanielBorkebyImage from "@/assets/images/DanielBorkeby.png";

const pageTitle = "Om Solopreneur";
const pageDescription =
  "Vad Solopreneur är, vem sidan är för och vem som står bakom - med länkar till verktyg, blogg, community och nyhetsbrev.";
---

<Layout title={`${pageTitle} – Solopreneur`} description={pageDescription}>
  <Header />

  <main id="main-content">
    <section class="pt-8 pb-6">
      <h1 class="so-section-title">Om Solopreneur</h1>
      <p class="so-section-muted">
        Solopreneur.se hjälper soloentreprenörer och små tjänstebolag att skapa struktur,
        lönsamhet och tillväxt. Jag är Daniel Borkeby, entreprenör med mer än 17 års erfarenhet, 
        och här delar jag verktyg, guider, råd om företagande, ekonomi och hur man bygger företag.
      </p>

      <div class="mt-4 flex flex-wrap gap-3">
        <a class="so-btn-primary" href="/nyhetsbrev/">Prenumerera</a>
        <a class="so-btn-secondary" href="/community/">Gå med i communityt</a>
        <a class="so-btn-secondary" href="/verktyg/">Se verktygen</a>
      </div>

      <ul class="mt-4 list-disc pl-5 text-sm text-foreground/80">
        <li>Klarspråk och konkreta genomgångar</li>
        <li>Praktiska flöden som går att använda direkt</li>
        <li>Struktur och ordning</li>
      </ul>
    </section>

    <section class="pt-2 pb-6">
      <h2 class="so-section-title">Snabblänkar</h2>

      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <a href="/verktyg/" class="so-card so-card-hover block p-5 sm:p-6">
          <div class="text-lg font-semibold tracking-tight">Verktyg</div>
          <p class="mt-2 text-sm text-foreground/75">Kalkylatorer, mallar och checklistor</p>
        </a>

        <a href="/posts/" class="so-card so-card-hover block p-5 sm:p-6">
          <div class="text-lg font-semibold tracking-tight">Blogg</div>
          <p class="mt-2 text-sm text-foreground/75">Genomgångar och perspektiv</p>
        </a>

        <a href="/playbooks/" class="so-card so-card-hover block p-5 sm:p-6">
          <div class="text-lg font-semibold tracking-tight">Guider</div>
          <p class="mt-2 text-sm text-foreground/75">"Steg för steg" guider</p>
        </a>
      </div>
    </section>

    <section class="pt-2 pb-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="so-card p-5 sm:p-6">
          <h2 class="text-xl font-semibold tracking-tight">Vad du får här</h2>
          <p class="mt-2 text-sm text-foreground/75">
            Samlade verktyg, guider och guider för att få bättre koll och underlätta ditt företagande,
            med fokus på genomförande.
          </p>
          <ul class="mt-3 list-disc pl-5 text-sm text-foreground/80">
            <li>guider för ekonomi, prissättning och lönsamhet</li>
            <li>Checklistor och mallar som sparar tid</li>
            <li>Genomgångar som går från strategi till praktik</li>
          </ul>
        </div>

        <div class="so-card p-5 sm:p-6">
          <h2 class="text-xl font-semibold tracking-tight">Vem Solopreneur är för</h2>
          <ul class="mt-3 list-disc pl-5 text-sm text-foreground/80">
            <li>Soloföretagare och konsulter som vill växa med kontroll</li>
            <li>Små tjänstebolag som behöver bättre struktur och uppföljning</li>
            <li>Du som vill starta företag på heltid eller vid sidan av anställning</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="pt-2 pb-6">
      <div class="so-card p-5 sm:p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
          <div class="shrink-0">
            <div class="size-24 sm:size-28 overflow-hidden rounded-full border border-border bg-muted" aria-hidden="true">
              <img
                src={DanielBorkebyImage.src}
                alt="Daniel Borkeby"
                class="h-full w-full object-cover so-avatar-img"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class="min-w-0 flex-1">
            <h2 class="text-xl font-semibold tracking-tight">Om Daniel Borkeby</h2>

            <p class="mt-2 text-sm text-foreground/75">
              Jag är företagsledare, CFO och entreprenör med över 17 års erfarenhet av ekonomi,
              bolagsstyrning och affärsutveckling. Jag har byggt och drivit bolag inom finans och redovisning,
              bland annat Paidin Finans AB och Paidin Redovisning AB, med fokus på tillväxt, struktur och lönsamhet.
            </p>

            <p class="mt-3 text-sm text-foreground/75">
              Erfarenhet från både ledningsgrupper och styrelsearbete har gett mig en helhetssyn på företagande:
              från strategi till praktiskt genomförande.
            </p>

            <p class="mt-3 text-sm text-foreground/75">
              Jag har under flera år varit mentor för nystartade företagare, bland annat via Almi.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pt-2 pb-10">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="so-card p-5 sm:p-6">
          <h2 class="text-xl font-semibold tracking-tight">Sponsring och partners</h2>
          <p class="mt-2 text-sm text-foreground/75">
            Solopreneur drivs fristående men med erfarenheterna från Paidin i ryggen.
          </p>
          <p class="mt-3 text-sm">
            Paidin Finans:
            <a
              class="ml-2 text-accent underline decoration-dashed underline-offset-4 hover:opacity-90"
              href="https://paidin.se"
              target="_blank"
              rel="noopener noreferrer"
            >
              paidin.se
            </a>
          </p>
        </div>

        <div class="so-card p-5 sm:p-6">
          <h2 class="text-xl font-semibold tracking-tight">Kontakt</h2>
          <p class="mt-2 text-sm text-foreground/75">
            För samarbeten:
            <a
              class="ml-2 text-accent underline decoration-dashed underline-offset-4 hover:opacity-90"
              href="mailto:support@paidin.se"
            >
              support@paidin.se
            </a>
          </p>
        </div>
      </div>

      <!-- Behåll endast om /integritet faktiskt finns -->
      <div class="so-card mt-4 p-5 sm:p-6">
        <h2 class="text-xl font-semibold tracking-tight">Policy</h2>
        <p class="mt-2 text-sm text-foreground/75">
          Integritets- och cookiepolicy:
          <a
            class="ml-2 text-accent underline decoration-dashed underline-offset-4 hover:opacity-90"
            href="/integritet"
          >
            /integritet
          </a>
        </p>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .so-avatar-img {
      object-position: 50% 28%;
    }
  </style>
</Layout>
