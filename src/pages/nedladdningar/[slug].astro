---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const entries = await getCollection("downloads", ({ data }) => !data.draft);

  return entries.map((p) => {
    const slug = String(p.data.slug ?? p.id).replace(/^\/+/, "");
    return { params: { slug }, props: { slug } };
  });
}

const { slug } = Astro.props as { slug: string };

const entries = await getCollection("downloads", ({ data }) => !data.draft);
const entry = entries.find((p) => String(p.data.slug ?? p.id).replace(/^\/+/, "") === slug);

if (!entry) return new Response(null, { status: 404 });

const title = entry.data.title;
const description =
  entry.data.description ??
  entry.data.ingress ??
  SITE.desc;

const pubDatetime = entry.data.pubDatetime;
const modDatetime = entry.data.modDatetime ?? null;

const dateStr = pubDatetime
  ? pubDatetime.toLocaleDateString("sv-SE", { year: "numeric", month: "2-digit", day: "2-digit" })
  : "";

const metaParts = [
  "NEDLADDNING",
  dateStr ? dateStr : null,
  (entry.data.kategori ?? "").trim() || null,
  (entry.data.nivå ?? "").trim() || null,
  (entry.data.tid ?? "").trim() || null,
  (entry.data.kostnad ?? "").trim() || null,
].filter(Boolean);

const file1 = entry.data.file;
const file2 = entry.data.file2;

const { Content } = await render(entry);
---

<Layout
  title={`${title} – Nedladdning`}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <main id="main-content" data-layout="download">
    <section class="pt-8 pb-10">
      <a href="/nedladdningar/" class="text-sm font-semibold text-foreground/70 hover:text-accent">
        &larr; Tillbaka till Nedladdningar
      </a>

      <h1 class="mt-3 text-3xl font-semibold tracking-tight">{title}</h1>

      <div class="mt-2 text-sm text-foreground/70">
        {metaParts.join(" · ")}
      </div>

      <div class="mt-6 so-card">
        <div class="p-5 sm:p-6">
          <div class="flex flex-wrap gap-3">
            {file1?.href && (
              <a class="so-btn-primary" href={file1.href} download>
                {file1.label ?? "Ladda ner"}
              </a>
            )}
            {file2?.href && (
              <a class="so-btn-secondary" href={file2.href} download>
                {file2.label ?? "Ladda ner (alternativ)"}
              </a>
            )}
          </div>

          <article class="app-prose w-full max-w-none mt-6">
            <Content />
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
