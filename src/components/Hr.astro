---
type Props = {
  class?: string;
  noPadding?: boolean;
};

const { class: className = "", noPadding = false } = Astro.props as Props;

const frameClass = ["so-hr-frame", noPadding ? "so-hr-frame--no-padding" : ""]
  .filter(Boolean)
  .join(" ");

const hrClass = ["so-hr", className].filter(Boolean).join(" ");
---

<div class={frameClass}>
  <hr class={hrClass} aria-hidden="true" />
</div>

<style>
  /* Samma bredd som innehåll/kort (inte fullbredd) */
  .so-hr-frame {
    max-width: var(--so-content-width, 1150px);
    margin: 0 auto;
    padding-left: clamp(16px, 3vw, 24px);
    padding-right: clamp(16px, 3vw, 24px);
  }

  /* Används där omgivande container redan har padding (t.ex. footer) */
  .so-hr-frame--no-padding {
    padding-left: 0;
    padding-right: 0;
  }

  /* Tydligare linje + tajtare vertikalt */
  .so-hr {
    border: 0;
    border-top: 1px solid rgba(15, 23, 42, 0.14);
    margin: 1.75rem 0;
  }

  :global(html.dark) .so-hr {
    border-top-color: rgba(255, 255, 255, 0.16);
  }
</style>
