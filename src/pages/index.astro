---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPath } from "@/utils/getPath";

import defaultCover from "@/assets/images/blog/default-cover.jpg";

import momsToolImage from "@/assets/images/tools/moms.jpg";
import timprisToolImage from "@/assets/images/tools/timpris.jpg";
import bildToolImage from "@/assets/images/tools/bild.jpg";

import paidinLogo from "@/assets/images/sponsors/paidin.png";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const heroPost = featuredPosts[0] ?? sortedPosts[0];

const toImageSrc = (v: unknown): string | null => {
  if (!v) return null;

  if (typeof v === "string") {
    const s = v.trim();
    return s.length ? s : null;
  }

  if (typeof v === "object" && v && "src" in v) {
    const src = (v as any).src;
    return typeof src === "string" && src.length ? src : null;
  }

  return null;
};

const heroHref = heroPost ? getPath(heroPost.id, heroPost.filePath) : "/posts/";
const heroDate =
  heroPost?.data?.pubDatetime
    ? heroPost.data.pubDatetime.toLocaleDateString("sv-SE", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
    : null;

const heroImage = toImageSrc(heroPost?.data?.ogImage) ?? defaultCover.src;

const latestPosts = sortedPosts
  .filter(p => (heroPost ? p.id !== heroPost.id : true))
  .slice(0, 4);

const playbookPosts = sortedPosts
  .filter(p => (p.data.kategori ?? "").toLowerCase() === "playbook")
  .slice(0, 3);

const quickLinks = [
  { label: "Guider", href: "/playbooks/" },
  { label: "Verktyg", href: "/verktyg/" },
  { label: "Nyhetsbrev", href: "/nyhetsbrev/" },
  { label: "Community", href: "/community/" },
  { label: "Om", href: "/om/" },
];

const tools = [
  {
    tag: "Skatt & prissättning",
    title: "Momskalkylator",
    description:
      "Räkna ut moms baklänges eller framlänges med 25, 12 eller 6 %. Se direkt moms och exkl. moms.",
    href: "/verktyg/moms-kalkylator",
    image: momsToolImage.src,
    imageAlt: "Momskalkylator",
  },
  {
    tag: "Skatt & prissättning",
    title: "Timpriskalkylator",
    description:
      "Räkna ut timpris baserat på mål, kostnader och debiterbar tid.",
    href: "/verktyg/timpriskalkylator",
    image: timprisToolImage.src,
    imageAlt: "Timpriskalkylator",
  },
  {
    tag: "Marknadsföring",
    title: "Bildverktyg",
    description:
      "Beskär och exportera bilder i rätt format för Instagram, Facebook, LinkedIn, YouTube och TikTok.",
    href: "/verktyg/",
    image: bildToolImage.src,
    imageAlt: "Bildverktyg",
  },
];

const sponsor = {
  label: "ANNONS · Paidin Finans",
  title: "Fakturera utan företag – kom igång med Paidin Finans",
  description:
    "Egenanställning för soloprenörer. Skicka din första faktura på några minuter – utan F-skatt och utan bokföring.",
  href: "https://paidin.se/",
  logo: paidinLogo.src,
  logoAlt: "Paidin",
};
---

<Layout
  title="Solopreneur – playbooks och verktyg för soloföretagare"
  description="Praktiska playbooks, verktyg och artiklar för att bygga ett lönsamt och hållbart soloföretag – med AI som operativ hävstång."
>
  <Header />

  <main id="main-content" data-layout="index">
<!-- Hero -->
<section class="pt-10 pb-10">
  <div class="so-hero so-hero-left-centered">
    <div class="so-hero-inner">
      <div class="so-eyebrow">Solopreneur</div>

      <h1 class="so-hero-title">
        Bygg ett effektivt soloföretag – med guider, verktyg och AI som hävstång
      </h1>

      <p class="so-hero-lead">
        Solopreneur samlar konkreta guider och verktyg som hjälper dig att planera,
        få användbara tips, sälja och leverera, lite enklare.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3 so-hero-actions">
        <a class="so-btn-primary" href="/nyhetsbrev/">Prenumerera</a>
        <a class="so-btn-secondary" href="/verktyg/">Se verktygen</a>
      </div>

      <div class="mt-6 flex flex-wrap gap-2 so-hero-links">
        {quickLinks.map(l => (
          <a class="so-pill-link" href={l.href}>{l.label}</a>
        ))}
      </div>
    </div>
  </div>
</section>



    <Hr />

    <!-- Utvalt + Senaste -->
    <section class="pt-8 pb-10">
      <div class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="so-section-title">Utvalt</h2>
          <p class="so-section-muted">Senaste utvalda inlägget.</p>

          {heroPost && (
            <a href={heroHref} class="so-card so-card-hover mt-5 block overflow-hidden">
              <img
                src={heroImage}
                alt={heroPost.data.title}
                class="so-featured-img"
                loading="eager"
                decoding="async"
              />

              <div class="p-5 sm:p-6">
                <div class="text-xs font-semibold tracking-wide text-foreground/60">
                  BLOGG · {heroDate}
                </div>

                <div class="mt-2 text-2xl font-semibold tracking-tight">
                  {heroPost.data.title}
                </div>

                {(heroPost.data.ingress ?? heroPost.data.description) && (
                  <p class="mt-2 text-sm text-foreground/75">
                    {heroPost.data.ingress ?? heroPost.data.description}
                  </p>
                )}

                <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                  Läs inlägget <IconArrowRight class="inline-block rtl:-rotate-180" />
                </div>
              </div>
            </a>
          )}

          <div class="mt-6">
            <a href="/posts/" class="so-btn-secondary inline-flex items-center gap-2">
              Visa alla inlägg <IconArrowRight class="inline-block rtl:-rotate-180" />
            </a>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <h2 class="so-section-title">Senaste</h2>
          <p class="so-section-muted">Snabba länkar till nya inlägg.</p>

          <div class="mt-5 so-card so-card-soft p-4 sm:p-5">
            {latestPosts.length === 0 ? (
              <div class="text-sm text-foreground/75">
                Inga fler inlägg att visa ännu.
              </div>
            ) : (
              <ul class="space-y-1">
                {latestPosts.map(p => {
                  const href = getPath(p.id, p.filePath);
                  const d =
                    p.data.pubDatetime?.toLocaleDateString("sv-SE", {
                      year: "numeric",
                      month: "2-digit",
                      day: "2-digit",
                    }) ?? "";

                  return (
                    <li>
                      <a href={href} class="so-latest-link">
                        <div class="so-latest-date">{d}</div>
                        <div class="so-latest-title">{p.data.title}</div>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        </aside>
      </div>
    </section>

    <Hr />

    <!-- Verktyg -->
    <section id="verktyg" class="pt-8 pb-10">
      <h2 class="so-section-title">Verktyg</h2>
      <p class="so-section-muted">
        Utvalda verktyg som löser vanliga problem snabbt. Fler kommer löpande.
      </p>

      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {tools.map(t => (
          <a href={t.href} class="so-card so-card-hover block overflow-hidden">
            {t.image && (
              <img
                src={t.image}
                alt={t.imageAlt ?? t.title}
                class="so-tool-img"
                loading="lazy"
                decoding="async"
              />
            )}

            <div class="p-5">
              <div class="text-xs font-semibold tracking-wide text-foreground/60">
                VERKTYG · {t.tag}
              </div>

              <div class="mt-2 text-lg font-semibold tracking-tight">
                {t.title}
              </div>

              <p class="mt-2 text-sm text-foreground/75">
                {t.description}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6">
        <a href="/verktyg/" class="so-btn-secondary inline-flex items-center gap-2">
          Visa alla verktyg <IconArrowRight class="inline-block rtl:-rotate-180" />
        </a>
      </div>
    </section>

    <!-- Nyhetsbrev -->
    <section class="pt-2 pb-10">
      <div class="so-card so-card-emphasis p-5 sm:p-6">
        <div class="text-lg font-semibold tracking-tight">
          Prenumerera på Solopreneur nyhetsbrev
        </div>

        <p class="mt-2 max-w-3xl text-sm text-foreground/75">
          Kort och konkret: det jag bygger, lär mig och rekommenderar – för dig som vill växa som soloprenör.
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a class="so-btn-primary" href="/nyhetsbrev/">
            Prenumerera
          </a>
          <a class="so-btn-secondary" href="/nyhetsbrev/">
            Läs mer
          </a>
        </div>
      </div>
    </section>

    <!-- Playbooks -->
    <section class="pt-2 pb-10">
      <h2 class="so-section-title">Guider</h2>
      <p class="so-section-muted">Steg-för-steg guider med fokus på genomförande.</p>

      {playbookPosts.length > 0 ? (
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {playbookPosts.map(p => (
            <a href={`/playbooks/${p.id}`} class="so-card so-card-hover block p-5">
              <div class="text-xs font-semibold tracking-wide text-foreground/60">
                GUIDER
              </div>

              <div class="mt-2 text-base font-semibold tracking-tight">
                {p.data.title}
              </div>

              {(p.data.ingress ?? p.data.description) && (
                <p class="mt-2 text-sm text-foreground/75">
                  {p.data.ingress ?? p.data.description}
                </p>
              )}
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-5 so-card p-5 sm:p-6">
          <div class="text-sm text-foreground/75">
            Fler guider kommer snart. Under tiden kan du börja med bloggen och verktygen.
          </div>
        </div>
      )}

      <div class="mt-6">
        <a href="/playbooks/" class="so-btn-secondary inline-flex items-center gap-2">
          Visa alla guider <IconArrowRight class="inline-block rtl:-rotate-180" />
        </a>
      </div>
    </section>

    <Hr />

    <!-- Community + Om -->
    <section class="pt-8 pb-10">
      <div class="grid gap-4 md:grid-cols-2">
        <a href="/community/" class="so-card so-card-hover block p-5 sm:p-6">
          <div class="text-lg font-semibold tracking-tight">Community</div>
          <p class="mt-1 text-sm text-foreground/75">
            Diskutera, få feedback och följ bygget i praktiken.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
            Gå med <IconArrowRight class="inline-block rtl:-rotate-180" />
          </div>
        </a>

        <a href="/om/" class="so-card so-card-hover block p-5 sm:p-6">
          <div class="text-lg font-semibold tracking-tight">Om Solopreneur</div>
          <p class="mt-1 text-sm text-foreground/75">
            Varför sidan finns och vad som byggs – med fokus på genomförande och lärdomar.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
            Läs mer <IconArrowRight class="inline-block rtl:-rotate-180" />
          </div>
        </a>
      </div>
    </section>

    <!-- Sponsrat -->
    <section class="pt-2 pb-12">
      <h2 class="so-section-title">Sponsrat</h2>

<a
  href={sponsor.href}
  target="_blank"
  rel="noopener noreferrer sponsored"
  aria-label={`${sponsor.title} (annons)`}
  class="mt-5 so-card so-card-hover block overflow-hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
         bg-[#fff6ea] text-slate-900 border border-black/5
         dark:bg-[#1b140a] dark:text-slate-100 dark:border-white/10"
>
  <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:gap-6 sm:p-6">
    <div class="min-w-0 flex-1">
      <div class="text-xs font-semibold tracking-wide text-slate-700/70 dark:text-slate-200/70">
        {sponsor.label}
      </div>

      <div class="mt-2 text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">
        {sponsor.title}
      </div>

      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200/80">
        {sponsor.description}
      </p>
    </div>

    {sponsor.logo && (
      <img
        src={sponsor.logo}
        alt={sponsor.logoAlt ?? "Sponsor"}
        class="h-14 w-auto rounded-md bg-white p-2 sm:h-16 dark:bg-white"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
</a>

    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = document.querySelector<HTMLElement>("#main-content")?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
