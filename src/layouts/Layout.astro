---
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string | undefined;
  canonicalURL?: string | URL | undefined;
  pubDatetime?: Date;
  modDatetime?: Date | null | undefined;
  scrollSmooth?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
} = Astro.props;

const baseUrl = new URL(SITE.website);
const canonicalAbs = canonicalURL instanceof URL ? canonicalURL : new URL(String(canonicalURL), baseUrl);
const socialImageURL = new URL(ogImage, baseUrl);

const pathname = Astro.url.pathname || "/";
const isHome = pathname === "/";
const isPost = !!pubDatetime;

const personId = new URL("#author", baseUrl).href;
const websiteId = new URL("#website", baseUrl).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: author,
  ...(profile ? { url: profile } : { url: baseUrl.href }),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  url: baseUrl.href,
  name: SITE.title,
  description: SITE.desc,
  inLanguage: SITE.lang,
  publisher: { "@id": personId },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: canonicalAbs.href,
  name: title,
  description,
  inLanguage: SITE.lang,
  isPartOf: { "@id": websiteId },
};

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  mainEntityOfPage: canonicalAbs.href,
  headline: title,
  description,
  image: [socialImageURL.href],
  datePublished: pubDatetime ? pubDatetime.toISOString() : undefined,
  dateModified: modDatetime ? modDatetime.toISOString() : undefined,
  author: { "@id": personId },
  isPartOf: { "@id": websiteId },
};

const structuredData = isHome
  ? [websiteSchema, personSchema]
  : isPost
    ? [websiteSchema, personSchema, blogPostingSchema]
    : [websiteSchema, personSchema, webPageSchema];

const ogType = isPost ? "article" : "website";
---
<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalAbs.href} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbs.href} />
    <meta property="og:image" content={socialImageURL.href} />

    <!-- Article Published/Modified time -->
    {pubDatetime && (
      <meta
        property="article:published_time"
        content={pubDatetime.toISOString()}
      />
    )}
    {modDatetime && (
      <meta
        property="article:modified_time"
        content={modDatetime.toISOString()}
      />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalAbs.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />

    <!-- JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="#77c043" />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}

    <ClientRouter />
    <script is:inline src="/toggle-theme.js"></script>
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
